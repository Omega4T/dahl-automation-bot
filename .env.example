# Dahl Farm — configuration
# Read automatically by dahl_farm.py on start (no manual export needed).
# Copy this file to `.env` and fill in your own values.

# ── Two usage modes ──────────────────────────────────────
#   1. POOL MODE (default) — use a proxy pool file (one URL per line in proxies.txt).
#      BRIGHTDATA_URL is NOT required. Run:  python dahl_farm.py bright 50
#   2. SINGLE PROXY — set BRIGHTDATA_URL to use one proxy for everything.

# Optional: a single proxy URL, e.g. http://user:pass@host:port
BRIGHTDATA_URL=

# ── Telegram summary (optional — leave blank to disable) ─
# When both are set, a farming summary with the keys is sent to this chat.
TG_BOT_TOKEN=
TG_CHAT_ID=
